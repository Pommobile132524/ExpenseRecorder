# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงจากโปรเจกต์ Supabase ของคุณ
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Salt สำหรับ hash เลขบัตรประชาชน — ตั้งเป็นสตริงสุ่มยาว ๆ แล้วห้ามเปลี่ยน
# (เปลี่ยนแล้วจะค้นลูกค้าเดิมจากเลขบัตรเต็มไม่เจอ)
HASH_SALT=CHANGE_ME_TO_A_LONG_RANDOM_STRING
